{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["scripts/*.ts"],
  "project": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}", "scripts/**/*.ts"],
  "ignoreDependencies": ["eslint-config-next", "postcss-load-config", "clsx", "date-fns", "tailwind-merge", "zod"],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
