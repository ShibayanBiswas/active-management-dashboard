{
  "name": "active-management-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3006",
    "build": "npx tsx scripts/ensure-repeated-sample.ts && next build",
    "start": "next start --port 3006",
    "lint": "eslint .",
    "lint:unused": "knip --no-progress",
    "typecheck": "tsc --noEmit",
    "bake": "npx tsx scripts/bake-seeds.ts",
    "bake:vol": "npx tsx scripts/bake-vol-surface.ts",
    "collate:multi": "npx tsx scripts/collate-multi-masters.ts",
    "build:samples": "npx tsx scripts/build-sample-inputs.ts",
    "seed": "npx tsx scripts/seed-mongo.ts",
    "verify:parity": "npx tsx scripts/verify-calculations.ts",
    "verify:edge": "npx tsx scripts/test-edge-cases.ts",
    "verify:pricer": "npx tsx scripts/verify-pricer-sheet.ts",
    "verify:samples": "npx tsx scripts/test-sample-roundtrip.ts",
    "verify:upload": "npx tsx scripts/test-upload-schema.ts",
    "verify:vol-expiries": "npx tsx scripts/verify-vol-expiries.ts",
    "verify:xlsm": "npx tsx scripts/verify-xlsm.ts",
    "verify:exports": "npx tsx scripts/verify-exports.ts",
    "verify:levels": "npx tsx scripts/audit-level-columns-parity.ts",
    "verify:multi-parse": "npx tsx scripts/verify-multi-parse.ts",
    "verify:desk-edit": "npx tsx scripts/verify-desk-edit.ts",
    "verify:downloads": "npx tsx scripts/verify-download-pipeline.ts",
    "verify:pricing": "npx tsx scripts/audit-pricing-e2e.ts",
    "verify:desk": "npx tsx scripts/e2e-local-desk.ts",
    "verify:embed": "npx tsx scripts/verify-embed-navigation.ts",
    "verify": "npm run typecheck && npm run verify:parity && npm run verify:edge && npm run verify:pricer && npm run verify:samples && npm run verify:upload && npm run verify:vol-expiries && npm run verify:xlsm && npm run verify:exports && npm run verify:levels && npm run verify:multi-parse && npm run verify:desk-edit && npm run verify:downloads && npm run verify:pricing && npm run verify:alignment && npm run verify:embed",
    "build:next": "next build",
    "build:samples:repeated": "npx tsx scripts/build-sample-inputs.ts --repeated-only",
    "ensure:repeated-sample": "npx tsx scripts/ensure-repeated-sample.ts",
    "verify:alignment": "npx tsx scripts/audit-desk-book-alignment.ts",
    "verify:mongo": "npx tsx scripts/test-mongo.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "framer-motion": "12.43.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "0.539.0",
    "mongodb": "6.17.0",
    "next": "15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.1",
    "xlsx": "0.18.5",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "eslint": "9.33.0",
    "eslint-config-next": "15.5.23",
    "knip": "5.88.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.4",
    "typescript": "5.9.2"
  }
}
